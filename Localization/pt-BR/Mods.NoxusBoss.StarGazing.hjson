		Espere...^^ hein??
		'''
}

ScreamingNebula: {
	Name: A Nebulosa Gritante
	SolynDialogue:
		'''
		Essa e a nebulosa gritante! Parece tao linda de perto assim...^^
		Voce sabe... nao tenho certeza por que a chamaram assim. No espaco, nao existe grito, nem som, para falar a verdade!
		'''
}