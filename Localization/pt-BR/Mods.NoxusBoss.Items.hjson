		'''
}

BibleOfSlime: {
	DisplayName: Biblia do Slime
	ObtainmentHint: "[c/F79BC6:Um slime pode ter este livro]"
	Tooltip:
		'''
		No comeco, das profundezas da lama primordial, Goozma, a essencia pura e inflexivel, emergiu
		De sua forma maleavel vieram graca e sabedoria, uma faisca de divindade testemunhada em cada slime

		Bem-aventurados os fluidos, pois eles se moverao com as mares do tempo, nunca quebrados pelas provacoes do destino. Bem-aventurados os sem forma, pois eles sempre encontrarao uma maneira de ser

		Todas as coisas, na forma de slime, sao uma com o fluxo da criacao

		Amen.
		'''
}

BookOfMiracles: {
	DisplayName: Livro Dos Milagres
	ObtainmentHint: "[c/F79BC6:Este livro pode ter algo a ver com um quarteto de maquinas de combate]"
