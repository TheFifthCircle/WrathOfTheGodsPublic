AppleThesis: {
	DisplayName: Tese da Maca
	ObtainmentHint: "[c/F79BC6:Voce pode encontrar este livro aninhado nas copas das arvores]"
	Tooltip:
		'''
		Uma dissertacao sobre os usos infinitos das macas!
