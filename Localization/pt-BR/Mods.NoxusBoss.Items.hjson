	Tooltip: Reinicia o estado do telescopio de Solyn, tornando-o reparavel novamente
}

StrangeFlagpole: {
	DisplayName: Mastro de Bandeira Estranho
	Tooltip:
		'''
		Pode ser usado para escolher onde Solyn montara acampamento
		Certifique-se de que ha espaco aberto e plano perto do mastro, ou o acampamento nao podera aparecer
		Colocar este mastro indica se o espaco proximo e suficientemente plano e aberto
		'''
	NotFlatEnoughText: Este espaco ou nao e plano ou nao e aberto o suficiente!
	FlatEnoughText: Este espaco e adequado.
}

